# Offline rule-based audit (no live AI):
# SAMPLE_MODE=true .venv/bin/python -m hydroguard.services.audit --domain Water
# --domain also accepts Land and Air; --claim accepts custom claim text.
# API: python run.py (loads .env; process variables take precedence).
# The standalone audit CLI reads process environment only; it does not load this file.
HYDROGUARD_LOG_DIR=logs
# Sponsor fields below are reserved and unused by the sample slice.
# HydroGuard
APP_NAME=HydroGuard
SAMPLE_MODE=true
LOG_LEVEL=INFO

# Zetaris direct REST smoke test: set these privately in .env.local.
# API base must end /api/v1.0; API key comes from the Zetaris GUI.
# Organisation ID is numeric. No sample-mode fallback is used by this test.
ZETARIS_REST_URL=
ZETARIS_API_KEY=
ZETARIS_ORG_ID=
# Verified regulatory table; optional override for the live retrieval adapter.
ZETARIS_REGULATORY_TABLE=HYDROGUARD.regulatory
# Optional path to a private config file; default is .env.local.
ZETARIS_ENV_FILE=.env.local
# Optional Basic auth for fetching /redoc/docs.yaml; not used by the smoke test.
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
# Legacy/future application placeholders; NOT aliases for direct REST config.
ZETARIS_BASE_URL=
ZETARIS_API_TOKEN=

# Meterless Nightshift
NIGHTSHIFT_BASE_URL=
NIGHTSHIFT_API_KEY=
NIGHTSHIFT_MODEL=

# NVIDIA Nemotron through Nightshift
NEMOTRON_MODEL=

# Meterless World Model
WORLD_MODEL_STORAGE_PATH=./data/world_model
WORLD_MODEL_NAMESPACE=hydroguard

# Investigation
MAX_INVESTIGATION_RETRIES=2
MAX_UPLOAD_MB=20

# Knowledge ingestion: no new credentials required for local extraction.
# Live passage verification uses ZETARIS_REST_URL/API_KEY/ORG_ID in .env.local.
# Private S3/workspace storage mapping must be verified before registration;
# never put S3 secrets or signed URLs in generated SQL or reports.

# Optional case-scoped synthetic project retrieval; configure both together.
# See docs/riverside-water-case.md for the verified Riverside table.
ZETARIS_PROJECT_TABLE=
ZETARIS_PROJECT_CASE_ID=

# Meterless Runtime setup is available in app.py (Streamlit).
# The token is stored privately in data/providers/meterless.json under
# meterless_runtime_token; never put a real token in this example file.
# Use --state-dir with scripts.verify_meterless to import stateDir/proxy-token.

# Isolated Nightshift Critic probe only; does not alter /run or sample mode.
# See docs/nightshift-critic-smoke.md for optional NIGHTSHIFT_BASE_URL,
# NIGHTSHIFT_API_KEY, METERLESS_RUNTIME_TOKEN and NIGHTSHIFT_MODEL overrides.
# Leave secrets in .env.local or private Runtime settings; no direct NVIDIA calls.

# Streamlit community UI: FastAPI server origin; no embedded credentials.
HYDROGUARD_API_URL=http://127.0.0.1:8000
