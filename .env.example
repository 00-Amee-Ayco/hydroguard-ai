# Offline audit: SAMPLE_MODE=true .venv/bin/python -m hydroguard.services.audit
# The audit CLI reads process environment only; it does not load this file.
# Sponsor fields below are reserved and unused by the sample slice.
# HydroGuard
APP_NAME=HydroGuard
SAMPLE_MODE=true
LOG_LEVEL=INFO

# Zetaris
ZETARIS_BASE_URL=
ZETARIS_API_TOKEN=

# Meterless Nightshift
NIGHTSHIFT_BASE_URL=
NIGHTSHIFT_API_KEY=
NIGHTSHIFT_MODEL=

# NVIDIA Nemotron through Nightshift
NEMOTRON_MODEL=

# Meterless World Model
WORLD_MODEL_STORAGE_PATH=./data/world_model
WORLD_MODEL_NAMESPACE=hydroguard

# Investigation
MAX_INVESTIGATION_RETRIES=2
MAX_UPLOAD_MB=20
